# ==============================================================================
# BYTECGLOBAL / BYTECCLOUD — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit .env.local or expose secret keys in client-side bundles.
# ==============================================================================

# Site URL (Canonical URL, sitemaps, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bytecglobal.com

# Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-Only Privileged Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication (jose JWT signing secret - minimum 32 random characters)
ADMIN_JWT_SECRET=your_super_secret_64_character_hex_or_passphrase_here

# First-time Super Admin Initialization (Used only once to seed the first admin if none exists)
INITIAL_ADMIN_EMAIL=admin@bytecglobal.com
INITIAL_ADMIN_PASSWORD=your_initial_secure_admin_password_here

# Email Inquiries & Notifications (Resend API)
CONTACT_RECIPIENT_EMAIL=inquiries@bytecglobal.com
RESEND_API_KEY=re_your_resend_api_key_here
