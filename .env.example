# BytecGlobal Environment Configuration
# Copy this file to .env.local for local development.

# Public site URL used for canonical URLs, sitemap, and Open Graph previews
NEXT_PUBLIC_SITE_URL=https://bytecglobal.com

# Supabase — contact form submissions (client-side, NEXT_PUBLIC_ prefix required)
# Project URL and publishable key from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
