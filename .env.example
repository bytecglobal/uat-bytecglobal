# ==============================================================================
# BytecCloud / BytecGlobal - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development.
# 2. Never commit actual secret keys or .env.local files to version control.
# 3. Configure production values in your hosting dashboard (Vercel, AWS, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL METADATA (PUBLIC)
# ------------------------------------------------------------------------------
# Production domain URL (no trailing slash). Used for canonical URLs, sitemap, and Open Graph previews.
NEXT_PUBLIC_SITE_URL=https://bytecglobal.com

# Public contact details displayed across the website
NEXT_PUBLIC_CONTACT_EMAIL=bytecglobal@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+00 000 000 0000

# WhatsApp business number with country code (digits only, e.g. 919876543210).
# If left empty or omitted, the floating WhatsApp button is safely hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 2. INQUIRY & EMAIL DELIVERY (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Verified recipient address where incoming website inquiries are delivered.
CONTACT_RECIPIENT_EMAIL=inquiries@bytecglobal.com

# Resend API Key for dispatching enquiry emails via the Resend REST API.
# Obtain from https://resend.com/api-keys
# If not configured during development, inquiries are safely logged to server console.
RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------------------------
# 3. ENTERPRISE ADMIN PANEL & AUTHENTICATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HS256 JWT admin session tokens.
# Generate a strong 64-character random string for production.
ADMIN_JWT_SECRET=your_super_secret_64_character_hex_or_passphrase_here

# Default super admin credentials seeded on first database initialization:
# Email: admin@bytecglobal.com
# Password: BytecAdmin@2025!
# Note: Change the password immediately via /admin/users or Profile after first login!
