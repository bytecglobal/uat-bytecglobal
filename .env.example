# BytecGlobal Environment Configuration
# Copy this file to .env.local for local development.

# Public site URL used for canonical URLs, sitemap, and Open Graph previews
NEXT_PUBLIC_SITE_URL=https://bytecglobal.com

# Supabase — contact form submissions
# Project URL from https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" secret key (server-side only, never expose publicly)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
