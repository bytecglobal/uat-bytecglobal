# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code and text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.html text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.docx binary
